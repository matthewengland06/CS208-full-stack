extends layout

block content
  h1= title
  p Welcome to #{title}
  ol
  each val in todos
    li
      form(method='POST' action='/edit')
        input(type='hidden', name='id', value=val.id)
        input(type='text', name='task', value=val.task, required)
        input(type='checkbox', name='completed', id='completed-' + val.id, checked=(val.completed > 0))
        label(for='completed-' + val.id, style='margin-right: 10px;')
          if val.completed > 0
            | Completed 
          else
            | Not Completed
        button(type='submit') Update

      form(method='POST' action='/delete')
          input(type='hidden', name='id', value=val.id)
          button.btn-outline.btn-delete(type='submit') Delete


  h2 Add a new task
  form(method='POST' action='/create', class='create-form')
    input(type='text', name='task', id='task', placeholder='Enter a new task', required)
    button.btn-outline(type='submit') Create Task